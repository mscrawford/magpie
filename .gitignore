
#ignore files created for a magpie calibration run
/calib_run/
magpie_calib.*

#ignore input files
*.cs*
!/data-changelog.csv
*.mz
*.rds
/input/

#ignore outputs
*.gdx
*.rda
*.opt
*.op2
*.lst
/output/

#ignore R support files
.Rhistory

#ignore documentation folder
/doc/

#ignore run specific files and folders
/225*/
/run_details/
/logs/
*.out
/scripts/npi_ndc/npi_ndc_overview.txt
Rplots.pdf

#ignore GAMS license
gamslice.txt

#ignore lock file
/.lock

/renv.lock
.Rproj.user

# Locally installed AI agent infrastructure (user-specific, NEVER push to pik-piam)
# These are clones/installs that live in the MAgPIE working tree but are not part of MAgPIE itself.
AGENT.md
CLAUDE.md
PREPROC_AGENT.md
/magpie-agent/
/magpie-preproc-agent/
.claude/
.copilot/

# Agent-side validation/report artifacts that may land in parent root
# (root cause: validate_consistency.sh historically wrote REPORT_DIR before chdir into agent;
#  fixed in scripts/validate_consistency.sh as of 2026-05-25, but kept here defensively)
validation_report_*.txt
.cache/
